{
  "uid": "booking-pipeline",
  "title": "Booking Pipeline (장애 트리아지)",
  "tags": [
    "team5",
    "booking",
    "triage"
  ],
  "description": "알림 → 사용자 영향 → 구간 판별 → 원인 후보 → 로그 순서로 위에서 아래로 확인 (analysis/10)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "알림 발화",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", team=\"team5\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{category}}",
        "useValueForTime": false
      },
      {
        "name": "장애 주입",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "max by (type) (fault_injected_ms) > 0",
        "step": "10s",
        "titleFormat": "장애 주입 {{type}}",
        "textFormat": "FaultInjector (Redis 키 fault:*)",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "1. 사용자 영향 — 지금 사용자가 불편한가",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "예약 확정 성공률 (5m)",
      "description": "SLO 99%, conflict(정상 거절) 제외. 예약 트래픽 없으면 0/0 → 트래픽 없음 표시",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(booking_confirm_total{result=\"confirmed\"}[5m])) / sum(rate(booking_confirm_total{result=~\"confirmed|failed\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "트래픽 없음",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "트래픽 없음",
                  "color": "text",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "트래픽 없음",
                  "color": "text",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "HTTP 5xx 비율 (5m)",
      "description": "알림 기준 5%. 5xx 시계열이 없을 때 0으로 계산",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
