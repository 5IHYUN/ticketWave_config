    {
      "type": "timeseries",
      "title": "구간별 p95",
      "description": "어느 선이 먼저 올라가는지로 구간 판별. ②만 상승 = Worker 부족/지연, ③ 상승 = DB, ① 상승 = SQS 브로커",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(booking_sqs_send_seconds_bucket[2m])))",
          "legendFormat": "① SQS 전송 (API 요청 스레드)",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(booking_queue_wait_seconds_bucket[2m])))",
          "legendFormat": "② 큐 대기 (생성→수신)",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(booking_worker_process_seconds_bucket[2m])))",
          "legendFormat": "③ Worker 처리 (커넥션 대기 포함)",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(booking_confirm_e2e_seconds_bucket[2m])))",
          "legendFormat": "e2e (요청→확정)",
          "refId": "D",
          "range": true
        }
      ],
